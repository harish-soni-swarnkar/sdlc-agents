{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/secrets/**)",
      "Grep(**/.env)",
      "Grep(**/.env.local)",
      "Grep(**/.env.*.local)",
      "Grep(**/.env.development)",
      "Grep(**/.env.production)",
      "Grep(**/.env.staging)",
      "Grep(**/.env.test)",
      "Grep(**/*.pem)",
      "Grep(**/*.key)",
      "Grep(**/secrets/**)",
      "Bash(cat *.env*)",
      "Bash(cat *secret*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf '%s' \"$input\" | jq -e '.stop_hook_active == true' >/dev/null 2>&1 && exit 0; git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; [ -n \"$(git status --porcelain)\" ] || exit 0; bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify.sh\" || { echo 'Verify failed (typecheck/tests) — fix before finishing.' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
